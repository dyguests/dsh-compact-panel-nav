{
  "name": "dsh-compact-panel-nav",
  "version": "1.3.1",
  "type": "module",
  "description": "Puts the sidebar's Plugins / Automations / More entries on one compact row, and New Session in the brand row as an icon.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "harness",
    "plugin",
    "client-plugin",
    "sidebar",
    "navigation",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyguests/dsh-compact-panel-nav.git"
  },
  "homepage": "https://github.com/dyguests/dsh-compact-panel-nav#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "assets/*.webp"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
